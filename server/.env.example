# Copy this file to server/.env and fill in real values.
# server/.env is already in .gitignore and must never be committed.
# Loaded in addition to the project-root .env (see server/env.js); values here win if
# both files define the same variable.

MONGODB_URI=
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Required: use a cryptographically random secret of at least 32 bytes.
# The server refuses to start with a missing, weak or placeholder secret.
# Never reuse example values or commit a real secret.
JWT_SECRET=

# Password reset: private Gmail SMTP configuration (App Password required).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Use a Gmail App Password, never your normal Google account password.
SMTP_PASS=
EMAIL_FROM=
# Public frontend origin (not the backend): HTTPS and no localhost in production.
APP_BASE_URL=http://localhost:5173
