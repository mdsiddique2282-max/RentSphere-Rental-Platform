{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rentsphere-backend-xry4.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://rentsphere-backend-xry4.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!api/|uploads/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}