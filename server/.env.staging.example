# Copy privately to server/.env.staging.local (gitignored).
# Never paste a real URI, password or JWT secret into reports, commands or chat.
# URI must explicitly select rentsphere_staging and rentsphere_staging_user
# on the approved cluster. There is no fallback to MONGODB_URI or production.
RENTSPHERE_STAGING_URI=
JWT_SECRET=
PORT=5000
# Optional: base64 encoding of a private 32-byte key for encrypted migration backups.
# Keep this key separate from backup files and out of source control.
RENTSPHERE_MIGRATION_BACKUP_KEY=

# Optional password-reset delivery. Keep real values only in .env.staging.local.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Gmail App Password, never your normal Gmail password.
SMTP_PASS=
EMAIL_FROM=
# Frontend origin for email links. Use the deployed HTTPS origin in production.
APP_BASE_URL=http://localhost:5173
